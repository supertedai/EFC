.DS_Store
.env
.env.*
__pycache__/
*.pyc
.venv/

# local-only
figshare/auth.json
_quarantine/

# Cobaya run artifacts created by running from the repo root
/chains/
docs/audit_report.md

# Git-worktrees som arbeidere lager under repoet. De ble commitet inn som
# gitlinks i #353 (`git add -A` i en utsjekk der de laa untracked og
# uignorerte) — ni stykker, uten .gitmodules, saa hver CI-kjoering endte med
# «fatal: No url found for submodule path '.worktrees/…'».
#
# En worktree er en LOKAL arbeidsflate. Den hoerer aldri hjemme i historikken.
.worktrees/

# Kunnskapslivssyklusen: råinntaket lever lokalt (append-only arbeidsdata);
# kandidater som skal bevares går til efc-banken.
data/inntak/

# TeX-byggeartefakter fra efc_pdf_bygg.sh (docker efc-tex) — deterministisk
# bygg, artefaktene hører ikke hjemme i historikken.
docs/papers/**/*.log
docs/papers/**/*.aux
docs/papers/**/*.out
.build.sha256

# uv-venv hører ikke hjemme i repoet
.venv/

# Byggeartefakter fra lokal pakkeinstallasjon
src/*.egg-info/
