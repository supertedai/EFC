.DS_Store
.env
.env.*
__pycache__/
*.pyc
.venv/

# local-only
figshare/auth.json
_quarantine/

# Cobaya run artifacts created by running from the repo root
/chains/
docs/audit_report.md

# Git-worktrees som arbeidere lager under repoet. De ble commitet inn som
# gitlinks i #353 (`git add -A` i en utsjekk der de laa untracked og
# uignorerte) — ni stykker, uten .gitmodules, saa hver CI-kjoering endte med
# «fatal: No url found for submodule path '.worktrees/…'».
#
# En worktree er en LOKAL arbeidsflate. Den hoerer aldri hjemme i historikken.
.worktrees/

# Kunnskapslivssyklusen: råinntaket lever lokalt (append-only arbeidsdata);
# kandidater som skal bevares går til efc-banken.
data/inntak/

# The arbiter connector's run log. Append-only runtime record, one line per run:
# what was routed where, why, and what was sent. It is the trace of the runs
# that publish nothing — which is every run until the arbiter exists — so it is
# local, like the rest of the runtime state.
logs/atlas-arbiter-konnektor.jsonl

# TeX-byggeartefakter fra efc_pdf_bygg.sh (docker efc-tex) — deterministisk
# bygg, artefaktene hører ikke hjemme i historikken.
docs/papers/**/*.log
docs/papers/**/*.aux
docs/papers/**/*.out
.build.sha256

# uv-venv hører ikke hjemme i repoet
.venv/

# Byggeartefakter fra lokal pakkeinstallasjon
src/*.egg-info/

# uv.lock: usporet artefakt fra en lokal `uv sync` (målt 2026-09-17: aldri
# sporet — `git log --all -- uv.lock` er tom). Makefile:install er
# `uv sync --frozen`, som KREVER en lås, så valget står mellom å spore den
# eller å ignorere den. Den ignoreres her fordi låsen ikke kan etterprøves på
# denne maskinen (uv er ikke installert, `uv lock --check` kan ikke kjøres) og
# `--frozen` feiler høylytt om den er ute av synk med pyproject.toml. Skal uv
# bli installasjonsveien, hører låsen i git sammen med en CI-sjekk som holder
# den fersk — ellers får vi en fjerde versjonskilde ingen validerer.
uv.lock
