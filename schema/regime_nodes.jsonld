      "id": "batteri.lading",
      "regime": {
        "name": "Laderegimet — CC/CV",
        "validity": "CC: constant current, rising voltage. CV: constant voltage, falling current. The knee between them is the transition — the charging regime's phase boundary.",
        "law_form": "two-stage charge protocol: CC to the voltage limit, CV thereafter"
      },
      "phase": "overgang",
      "measure": {
        "target": "ladekurven V(t), I(t)",
        "measurer": "the charger (VE.Bus inverter, private installation)",
        "instrument": "V/I sensors in the charger",
        "proxy_chain": [
          "V, I over time -> the charge curve",
          "current decay under CV below the current threshold -> charge-end CRITERION (SOC ~ 1, but not automatic; terminated by threshold/time criterion)",
          "CC phase length -> utilised capacity"
        ],
        "placement": "the charger controls and measures in the same loop",
        "compression": "charge history -> one knee point (the time series is required to document the knee)"
      },
      "episenter": "the knee: CC -> CV is the phase transition of the charge regime — the triple-point analogy: two regimes (current-driven and voltage-driven) meet in one point",
      "buffer": {
        "role": "the charger is the buffer's filling mechanism: it controls how fast the energy flows in",
        "note": "the buffer's input."
      },
      "ontology": {
        "assumes": [
          "the CC/CV protocol is the canonical charging protocol for LiFePO4",
          "the knee is a real regime shift, not just an adjustment"
        ],
        "source": "The VE.Bus charge protocol — «Effective charge voltage», «Charge voltage setpoint» and BMS-CVL are three different levels (values in a private artifact): effective setpoint, charger setpoint and BMS limit; a single instantaneous measurement does NOT document the CC->CV knee itself",
        "proveniens": {
          "kilder": [
            {
              "type": "intern",
              "ref": "schema/regime_nodes.jsonld#batteri.lading",
              "hentet": "2026-09-18"
