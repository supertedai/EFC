    {
      "id": "efc.jordskjelv_engine",
      "regime": {
        "name": "The Earth's holding->release (fault buffer)",
        "validity": "holding: stress < 3000000.0 Pa — the fault charges, no release; release: stress >= 3000000.0 Pa — the buffer is released. IDEALIZED regime model (Burridge-Knopoff-style charging): the release happens at a fixed threshold and the whole stress drop is released. Invalid input (negative or non-finite stress) is outside the window and gives NaN — never a guess: the buffer charges from stress = 0. Does NOT predict single earthquakes.",
        "law_form": "gjentakelsestid = terskel / lade_rate; M0 = mu * A * (terskel/mu); Mw = (2/3)(log10 M0 - 9.1)"
