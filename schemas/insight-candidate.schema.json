{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertedai.github.io/EFC/schemas/insight-candidate.schema.json",
  "title": "InsightCandidate — EFC innsiktspipeline fase 1",
  "type": "object",
  "required": [
    "insight_id", "source_role", "writer_role", "run_id", "claim",
    "claim_type", "scope", "source_refs", "confidence", "status",
    "content_hash", "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "insight_id": {"type": "string", "pattern": "^INS-[0-9a-f]{8,}$"},
    "source_role": {"enum": ["researcher", "opus", "external", "verifier"]},
    "writer_role": {"enum": ["researcher", "orchestrator", "verifier"]},
    "run_id": {"type": "string", "minLength": 8},
    "claim": {"type": "string", "minLength": 10, "maxLength": 4000},
    "claim_type": {"enum": ["observation", "interpretation", "hypothesis", "prediction", "method", "correction"]},
    "scope": {"type": "string", "minLength": 3},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["uri", "retrieved_at"],
                "properties": {"uri": {"type": "string"}, "retrieved_at": {"type": "string", "format": "date-time"},
                               "content_hash": {"type": "string"}}}
    },
    "input_artifacts": {
      "type": "array",
      "items": {"type": "object", "required": ["uri", "sha256"],
                "properties": {"uri": {"type": "string"}, "sha256": {"type": "string"},
                               "artifact_type": {"type": "string"}}}
    },
    "provenance": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "counterevidence": {"type": "array", "items": {"type": "object"}},
    "falsification_test": {"type": "string"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "contradicts": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["candidate", "needs-rework", "quarantined", "unknown"]},
    "created_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
