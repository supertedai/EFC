{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertedai.github.io/EFC/theory/formal/efc-d-model/schema.json",
  "required": [
    "@context",
    "@type",
    "identifier",
    "name",
    "version"
  ],
  "properties": {
    "@context": { "type": "string" },
    "@type": { "type": "string" },
    "identifier": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "object" },
    "about": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hasPart": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
