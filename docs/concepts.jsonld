    {
      "@id": "efc:S0",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "S0",
        "@language": "en"
      },
      "skos:notation": "S0",
      "skos:inScheme": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:topConceptOf": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:scopeNote": {
        "@value": "The token S0 is used in several senses that no source reconciles (measured 2026-09-13). The variable-light paper (10.6084/m9.figshare.30642497) reads it as one of two entropic phases, “s0 rigidity”; validity-aware-ai (10.6084/m9.figshare.31122970) defines “S0: the total space of possible structures and dynamics”; theory/formal/efc-c0-model records “S0: Low-entropy reference regime”; and EFC v2.1 Complete Edition (10.6084/m9.figshare.30478916) writes the thermodynamic boundary in an equals form (“S = 0”) — not as the S0 token; the tree phrases the boundary itself several different ways. The registry therefore defines nothing and lists the sources that name the term. No source identifies S0 with an L0–L3 layer; the Foundations paper (10.6084/m9.figshare.31135597) keeps “S0–S1 observational regimes” distinct from the “L0–L3 regime architecture”.",
        "@language": "en"
      },
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.6084/m9.figshare.30642497"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.31122970"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.31135597"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/variable-light-s0-s1/README.md"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/validity-aware-ai/docs/paper_unified_architecture_statement.md"
        }
      ],
      "efc:entityType": "concept",
      "efc:registryStatus": "candidate"
    },
    {
      "@id": "efc:S1",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "S1",
        "@language": "en"
      },
      "skos:notation": "S1",
      "skos:inScheme": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:topConceptOf": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:scopeNote": {
        "@value": "The token S1 is used in several senses that no source reconciles (measured 2026-09-13). The variable-light paper (10.6084/m9.figshare.30642497) reads it as one of two entropic phases, “s1 dissipation”; validity-aware-ai (10.6084/m9.figshare.31122970) defines “S1: the realized universe or system instantiated within that space”; theory/formal/efc-c0-model records “S1: High-entropy reference regime”; and EFC v2.1 Complete Edition (10.6084/m9.figshare.30478916) writes the thermodynamic boundary in an equals form (“S = 1”) — not as the S1 token; the tree phrases the boundary itself several different ways. The registry therefore defines nothing and lists the sources that name the term. No source identifies S1 with an L0–L3 layer; the Foundations paper (10.6084/m9.figshare.31135597) keeps “S0–S1 observational regimes” distinct from the “L0–L3 regime architecture”.",
        "@language": "en"
      },
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.6084/m9.figshare.30642497"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.31122970"
