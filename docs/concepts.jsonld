    {
      "@id": "efc:GHF",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Grid–Higgs Framework",
        "@language": "en"
      },
      "skos:altLabel": [
        {
          "@value": "GHF",
          "@language": "en"
        },
        {
          "@value": "Grid-Higgs Framework",
          "@language": "en"
        }
      ],
      "skos:notation": "GHF",
      "skos:inScheme": {
