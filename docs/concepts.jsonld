      },
      "skos:definition": {
        "@value": "Introduces the Grid-Higgs Framework, which models spacetime as a dynamic grid whose structural nodes are Higgs-field excitations.",
        "@language": "en"
      },
      "efc:definitionQuotedFrom": {
        "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-Grid-Higgs-Framework/README.md#L15",
