        {
          "@value": "EFC–C",
          "@language": "en"
        },
        {
          "@value": "Cognitive entropy framework",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Introduces EFC-C, a thermodynamic framework that models the brain as an open system governed by entropy-gradient dynamics.",
        "@language": "en"
      },
      "efc:definitionQuotedFrom": {
        "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-C_A_Thermodynamic_Framework_for_Cognitive_Entropy_and_Psychiatric_Biomarkers_Track_2/README.md#L15",
        "efc:quoteSha256": "d4fe5792c544de29b4ff3a6da8ad38900fe477e8433f0a40f7d6d89d5b2fc8fe"
      },
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.6084/m9.figshare.31940505"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.32091700"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-C_A_Thermodynamic_Framework_for_Cognitive_Entropy_and_Psychiatric_Biomarkers_Track_2/README.md"
        }
      ],
