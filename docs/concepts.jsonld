    },
    {
      "@id": "efc:EFCR",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "EFC-R",
        "@language": "en"
      },
      "skos:notation": "EFC-R",
      "skos:inScheme": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:altLabel": [
        {
          "@value": "EFC–R",
          "@language": "en"
        },
        {
          "@value": "Regime sector",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "EFC-R governs **galactic-scale dynamics** where spatial entropy gradients\nmodify the effective gravitational potential without introducing dark matter\nor altering cosmic expansion.",
        "@language": "en"
      },
      "efc:definitionQuotedFrom": {
        "@id": "https://github.com/supertedai/EFC/blob/main/theory/formal/efc-r-model/README.md#L6-L8",
