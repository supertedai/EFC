    },
    {
      "@id": "efc:EFC",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Energy-Flow Cosmology",
        "@language": "en"
      },
      "skos:altLabel": [
        {
          "@value": "EFC",
          "@language": "en"
        }
      ],
      "skos:notation": "EFC",
      "skos:inScheme": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:topConceptOf": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:definition": {
        "@value": "Presents the Complete Edition of Energy-Flow Cosmology (EFC v2.1), a unified thermodynamic framework where a continuous energy–entropy flow field Ef generates spacetime structure, cosmic dynamics, and reflexive cognition.",
        "@language": "en"
      },
      "efc:definitionQuotedFrom": {
        "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-v2.1-Complete-Edition/README.md#L15",
        "efc:quoteSha256": "a23824a3ca743c2a4de20a08807188790a04a48f9939a7c3960ad0bd87fd159c"
      },
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.6084/m9.figshare.30563738"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.30478916"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-v2.1-Complete-Edition/README.md"
        }
      ]
    },
