      "dcterms:title": {
        "@value": "Energy-Flow Cosmology (EFC) — core concepts",
        "@language": "en"
      },
      "dcterms:description": {
        "@value": "The five core EFC concepts named by api/concept-index.json since 2026-01, registered once, in SKOS, against the efc: vocabulary. Definitions are verbatim sentences from documents in this repository (efc:definitionQuotedFrom); where the tree holds no defining sentence the concept says so in a scopeNote. Meaning lives here; identity lives in the vocabulary (docs/ontology.jsonld).",
        "@language": "en"
      },
      "dcterms:creator": {
        "@id": "https://orcid.org/0009-0002-4860-5095"
      },
      "dcterms:modified": "2026-09-06",
      "skos:hasTopConcept": [
