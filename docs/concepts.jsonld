    {
      "@id": "efc:GHF",
      "@type": "skos:Concept",
      "skos:prefLabel": {
        "@value": "Grid–Higgs Framework",
        "@language": "en"
      },
      "skos:altLabel": [
        {
          "@value": "GHF",
          "@language": "en"
        },
        {
          "@value": "Grid-Higgs Framework",
          "@language": "en"
        }
      ],
      "skos:notation": "GHF",
      "skos:inScheme": {
        "@id": "https://supertedai.github.io/EFC/concepts.jsonld"
      },
      "skos:definition": {
        "@value": "Introduces the Grid-Higgs Framework, which models spacetime as a dynamic grid whose structural nodes are Higgs-field excitations.",
        "@language": "en"
      },
      "efc:definitionQuotedFrom": {
        "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-Grid-Higgs-Framework/README.md#L15",
        "efc:quoteSha256": "f8a9aedcf45d29452bb80a3adc0d1a6ac3b9f7111dc0ba6a69ddb78bf8eaeeb0"
      },
      "skos:broader": {
        "@id": "efc:EFC"
      },
      "dcterms:source": [
        {
          "@id": "https://doi.org/10.6084/m9.figshare.28559510"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.28560935"
        },
        {
          "@id": "https://doi.org/10.6084/m9.figshare.30468737"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/docs/papers/efc/EFC-Grid-Higgs-Framework/README.md"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/theory/architecture/README.md"
        },
        {
          "@id": "https://github.com/supertedai/EFC/blob/main/figshare/figshare-links.json"
        }
      ],
      "skos:scopeNote": {
        "@value": "The tree carries two DOI attributions for GHF (measured 2026-09-06): the papers titled Grid-Higgs Framework / Grid-Higgs Paradigm Shift (10.6084/m9.figshare.28559510, 28560935), and the Figshare dataset 'Grid–Higgs Framework (GHF)' in figshare/figshare-links.json (10.6084/m9.figshare.30468737, 'Energy-Flow Interface'). All three are listed as sources; the registry does not decide which is canonical.",
        "@language": "en"
      },
      "efc:entityType": "concept",
      "efc:registryStatus": "candidate"
    },
