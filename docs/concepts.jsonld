      "skos:scopeNote": {
        "@value": "The expansion of IMX differs between sources in this repository (measured 2026-09-06): api/concept-index.json (2026-01) says 'Informational Metastructure Extension'; theory/architecture/README.md lists 'IMX informational metastructure' among the extensions; the abstract of EFC v2.1 Complete Edition names 'an Intelligence–Matter Exchange (IMX) model'. No source in the tree states whether these are one concept. The registry records the discrepancy and defines nothing.",
        "@language": "en"
      },
      "efc:entityType": "concept",
