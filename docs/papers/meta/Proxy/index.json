  "sealed_predictions": [
    {"id": "P1", "statement": "Residuals at regime boundaries are systematically larger and less coherent than residuals within interiors."},
    {"id": "P2", "statement": "Proxy substitution induces structured, directionally consistent drift in fitted parameters within the same regime."},
    {"id": "P3", "statement": "Episenter shifts reorganise apparent signal/residual structure without changing raw data."},
    {"id": "P4", "statement": "Placement matching reduces apparent conflicts between models or measurements."}
  ],
