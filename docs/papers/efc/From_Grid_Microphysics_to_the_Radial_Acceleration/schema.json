{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid Microphysics to RAR – Validation Schema",
  "description": "Schema for validating the minimal gradient-coupled excitation model that bridges EFC microphysics to the observed RAR",
  "type": "object",
  "required": ["three_assumptions", "derivation", "lattice_derivation", "falsification_conditions"],
  "properties": {
    "three_assumptions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "content"],
        "properties": {
          "id": {"type": "string", "enum": ["A1", "A2", "A3"]},
          "name": {"type": "string"},
          "content": {"type": "string"}
        }
      }
    },
    "derivation": {
      "type": "object",
      "required": ["target_form", "result"],
      "properties": {
        "target_form": {"type": "string", "const": "mu(g) = 1/(exp(sqrt(g/a0)) - 1)"},
        "result": {"type": "string"}
      }
    },
    "lattice_derivation": {
      "type": "object",
      "required": ["spring_constant", "frequency_scaling"],
      "properties": {
        "spring_constant": {"type": "string", "const": "k_eff = g/l_g"},
        "frequency_scaling": {"type": "string", "const": "omega proportional to sqrt(g)"}
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "condition"],
        "properties": {
          "id": {"type": "string"},
          "condition": {"type": "string"}
        }
      }
    },
    "a0": {
      "type": "object",
      "properties": {
        "value": {"type": "number", "const": 1.2e-10},
        "unit": {"type": "string", "const": "m/s^2"},
        "status": {"type": "string", "enum": ["measured", "derived"]}
      }
    }
  }
}
