{
  "title": "Local Degree Heterogeneity — Results Data",
  "doi": "10.6084/m9.figshare.31940370",
  "kappa_definition": {
    "formula": "kappa = <S_hub> / <S_periph>",
    "hub_threshold": "top 10% by weighted structural degree",
    "periphery_threshold": "bottom 30% by weighted structural degree",
    "interpretation": {
      "kappa_gt_1": "Centrifugal gradient: hubs have higher functional variability",
      "kappa_eq_1": "No gradient: entropy uniformly distributed",
      "kappa_lt_1": "Centripetal gradient: periphery has higher variability"
    }
  },
  "entropy_proxies": {
    "primary": {
      "name": "FC-CV (functional connectivity coefficient of variation)",
      "formula": "S_i = std(FC_i) / mean(|FC_i|)",
      "available_for": "Dataset 1 (group-average with functional matrices)"
    },
    "secondary": {
      "name": "Structural log-degree",
      "formula": "S_i = log(1 + degree_i)",
      "available_for": "Both datasets"
    }
  },
  "dataset_1_group_average": {
