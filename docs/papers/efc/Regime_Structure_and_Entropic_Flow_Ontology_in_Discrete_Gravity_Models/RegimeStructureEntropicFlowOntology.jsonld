  "@type": "ScholarlyArticle",
  "@id": "efc:RegimeStructureEntropicFlowOntology",
  "name": "Regime Structure and Entropic Flow Ontology in Discrete Gravity Models",
  "headline": "Three gravitational regimes emerge from dominance transitions in a single discrete entropic functional, with Λ as bulk capacity parameter",
  "author": {
    "@type": "Person",
    "name": "Morten Magnusson",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "ORCID",
      "value": "0009-0002-4860-5095"
    }
  },
  "datePublished": "2026-02-16",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "1.0",
  "keywords": [
    "regime structure",
    "entropic flow ontology",
    "discrete gravity",
    "graph functionals",
    "AQUAL",
    "MOND",
    "cosmological constant",
    "bulk entropic capacity",
    "emergent spacetime",
    "Energy-Flow Cosmology"
  ],
  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:DiscreteEntropicFunctional",
      "name": "Discrete Entropic Functional",
      "description": "Three-sector functional F[Φ] on a graph: gradient (nearest-neighbour AQUAL coupling), bulk (quadratic Λ-anchoring to Φ_V), and source (linear matter coupling)"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:RegimeDominanceMap",
      "name": "Regime Dominance Map",
      "description": "Classification of field configurations into UV (Newtonian), IR (MOND-like), or Cosmological regimes via dimensionless ratios ξ = |∇Φ|/a₀ and η = μ_Λ Φ/|∇²Φ|"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:BulkEntropicCapacity",
      "name": "Bulk Entropic Capacity (Λ)",
      "description": "Λ functions as a bulk capacity parameter: locally sets MOND scale a₀ ∝ c²√Λ, globally sets screening length L_Λ ∝ Λ⁻¹/² ~ 4.4 Gpc"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:EntropicFlowOntology",
      "name": "Entropic Flow Ontology",
      "description": "Ontological framework: entropy is network capacity, energy flow is gradient redistribution, spacetime is emergent from graph structure, time is equilibrium relaxation"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:InterpolatingFunction",
      "name": "Standard Interpolating Function",
      "description": "μ(x) = x/√(1+x²), providing smooth transitions between Newtonian (μ→1) and MOND (μ~x) regimes"
    }
  ],
  "mainEntity": {
    "@type": "Claim",
    "name": "Regime Exhaustiveness",
    "description": "The UV, IR, and Cosmological regimes are exhaustive: for any field configuration, exactly one sector of the discrete entropic functional dominates, producing the corresponding gravitational behaviour without requiring separate theoretical frameworks"
  },
  "isPartOf": {
    "@type": "CreativeWorkSeries",
    "name": "Energy-Flow Cosmology Framework",
