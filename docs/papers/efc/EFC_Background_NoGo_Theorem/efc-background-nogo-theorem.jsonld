  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:BackgroundNoGo",
      "name": "Background No-Go Theorem",
      "description": "ΔE²(z) = A·[g(z) − g(0)] ≤ 0 for all z > 0 under closure normalisation. Background-level EFC modification enhances growth, cannot suppress σ₈."
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:AlphaCollapse",
      "name": "Observational α-Collapse",
      "description": "Under joint CMB+BAO constraints, the background coupling parameter α collapses to ≈ 0 with perfect α–H₀ degeneracy (r = 0.975)."
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:PerturbationRedirection",
      "name": "Perturbation Sector Redirection",
      "description": "Background no-go forces all EFC effects into the perturbation sector: μ ≈ 0.94, Σ ≈ 1.05, η ≈ 1.10."
    }
  ],
  "mainEntity": {
    "@type": "Claim",
    "name": "Background Sector Structural Exclusion",
    "description": "The EFC background coupling channel is structurally excluded for σ₈ suppression (sign lemma) and observationally empty (α → 0 under CMB+BAO). This is a constructive boundary that redirects EFC to the perturbation sector."
  },
