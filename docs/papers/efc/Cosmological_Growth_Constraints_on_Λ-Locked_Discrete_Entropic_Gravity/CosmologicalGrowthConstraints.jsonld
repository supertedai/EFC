  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:EffectiveGravitationalCoupling",
      "name": "Effective Gravitational Coupling G_eff(k)",
      "description": "Lorentzian window: G_eff(k)/G = 1 + (C²−1)/(1+(k/k_Λ)²), screening infrared enhancement above k_Λ"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:LambdaLockingViability",
      "name": "Λ-Locking Viability Condition",
      "description": "L_Λ ≳ H₀⁻¹ required for cosmological consistency; follows from L_Λ ∝ Λ^{-1/2}"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:CatastrophicOvergrowth",
      "name": "Catastrophic Overgrowth",
      "description": "Sub-Hubble transition scales produce σ₈ >> 1 (factors of 450–30,000 above ΛCDM)"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:LinearGrowthEquation",
      "name": "Linear Growth Equation",
      "description": "δ'' + (2+H'/H)δ' − (3/2)Ω_m(a)[G_eff(k)/G]δ = 0"
    }
  ],
  "mainEntity": {
    "@type": "Claim",
    "name": "Λ-Locking Necessity",
    "description": "Λ-locking is a necessary condition for cosmological consistency of any infrared-enhanced gravity model"
  },
