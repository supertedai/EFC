  "key_equations": {
    "deep_mond_enhancement": "g = C √(a₀ g_N)",
    "geff_ratio": "G_eff(k)/G = 1 + (C²−1) / (1 + (k/k_Λ)²)",
    "transition_wavenumber": "k_Λ = 1/L_Λ, L_Λ ∝ Λ^{-1/2}",
    "growth_equation": "δ'' + (2 + H'/H)δ' − (3/2)Ω_m(a)[G_eff(k)/G]δ = 0",
