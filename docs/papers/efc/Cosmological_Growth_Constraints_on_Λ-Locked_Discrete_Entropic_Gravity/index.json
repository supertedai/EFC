        "k_transition": null,
        "sigma8": 0.811,
        "gamma": 0.554,
        "viable": true
      },
      {
        "name": "Graph-AQUAL (Λ-locked)",
        "transition_scale_Gpc": 4.4,
        "k_transition_h_per_Mpc": 0.0014,
        "sigma8": 0.814,
        "gamma": 0.554,
        "sigma8_excess_percent": 0.4,
