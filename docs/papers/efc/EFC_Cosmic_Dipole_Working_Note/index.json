  "abstract": "Examines whether EFC contains a natural mechanism for the observed galaxy number count dipole excess (2-3x kinematic prediction). Identifies the key ingredient: isotropy is a regime condition valid in L0/L1, not an absolute postulate. Any residual entropy gradient ∇S imprints a preferred direction via G_eff(S). Required gradient is ~2% across the observable volume, consistent with CMB constraints.",

  "keywords": ["cosmic dipole", "number count dipole", "anisotropy", "entropy gradient", "regime-dependent isotropy", "cosmological principle", "CatWISE", "NVSS", "EFC"],

  "key_equations": {
    "G_eff": "G_eff(S) = G_N(1 + μ(S))",
    "directional_G_eff": "ΔG_eff(n̂) ≈ G_N μ₀ f'(S̄) (∇S · n̂) L_grad",
    "dipole_amplitude": "D_EFC ≈ (b_eff/2) μ₀ |f'(S̄)| |∇S| L_grad / S̄",
    "required_gradient": "|∇S| L_grad / S̄ ≈ 0.023 (for D_excess ≈ 0.007)"
  },

  "observational_context": {
    "D_kinematic": "~0.0045 (from v ≈ 370 km/s)",
    "D_observed": "0.008–0.015 (NVSS, CatWISE, WISE-SuperCOSMOS)",
    "D_excess": "0.005–0.010 (2–3× kinematic)",
    "alignment": "Approximately aligned with CMB dipole"
  },

  "predictions": [
    {"id": "P1", "description": "Redshift dependence: dipole excess grows with decreasing z"},
