{
  "title": "Consciousness Field Resonance Empirical Data",
  "description": "Summary empirical data from EEG propofol sedation study (Chennu et al. 2016) analyzed under the CEM framework",
  "author": "Morten Magnusson",
  "license": "CC-BY-4.0",
  "data_source": {
    "dataset": "Chennu et al. 2016",
    "subjects": 20,
    "overlap_cohort": 12,
    "paradigm": "Propofol sedation EEG"
  },
  "key_results": {
    "differentiation_effect": {
      "measure": "Omega (full band)",
      "cohens_d": 1.50,
      "p_value": 0.073,
      "interpretation": "Strong - primary marker of consciousness"
    },
    "integration_effect": {
      "measure": "kappa (global TE)",
      "cohens_d": 0.42,
      "p_value": 0.530,
      "interpretation": "Weak, not significant"
    },
    "product_test_F1": {
      "measure": "C = Omega(4-40Hz) x kappa",
      "cohens_d": 0.63,
      "p_value": 0.432,
      "status": "FALSIFIED"
    },
    "regional_posterior": {
      "measure": "C(parietal)",
      "cohens_d": 2.10,
      "p_value": 0.018,
      "status": "Exploratory candidate"
    },
    "balance_signal": {
      "measure": "corr(Omega, kappa)",
      "value": -0.27,
      "interpretation": "Trade-off: higher differentiation = lower integration"
    }
  },
  "double_dissociation": {
    "responsive": {"delta_omega": 0.054, "p_value": 0.001},
    "drowsy": {"delta_omega": -0.063, "p_value": 0.016},
    "interpretation": "Drug does not determine direction - consciousness does"
  },
