    {
      "@type": "DefinedTerm",
      "@id": "efc:SurvivalValley",
      "name": "Survival Valley",
      "description": "Parameter region where μ ∈ [0.90, 0.97], η > 1.05, Σ > 1.0 simultaneously satisfied"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:StiffnessResponse",
      "name": "Stiffness Response R(k)",
      "description": "R(k) ∝ k⁻⁴, the mechanism driving the regime transition via the flow constraint"
    }
