{
  "title": "AI Workflow Framework Reference Data",
  "description": "Default pipeline configuration and role definitions for the EFC AI workflow framework.",
  "roles": [
    {"id": "human_theorist", "label": "Human Theorist", "description": "Develops theoretical framework and hypotheses."},
    {"id": "ai_structural", "label": "AI Structural Assistant", "description": "Structures, stabilises, and encodes theoretical content."},
    {"id": "computational", "label": "Computational Pipeline", "description": "Reproducible numerical analysis and statistical testing."},
    {"id": "metadata_semantic", "label": "Metadata & Semantic", "description": "Generates JSON-LD metadata, citations, and schemas."}
  ],
  "default_pipeline": [
    {
      "stage": "Theoretical Formulation",
      "role": "human_theorist",
      "inputs": ["prior_knowledge", "observational_data"],
      "outputs": ["hypothesis", "equations"],
      "validation": ["internal_consistency"]
    },
    {
      "stage": "Structural Encoding",
      "role": "ai_structural",
      "inputs": ["hypothesis", "equations"],
      "outputs": ["structured_document", "schema"],
      "validation": ["schema_valid", "no_hallucination"]
    },
    {
      "stage": "Computational Validation",
      "role": "computational",
      "inputs": ["structured_document", "datasets"],
      "outputs": ["results", "figures"],
      "validation": ["reproducibility", "statistical_significance"]
    },
    {
      "stage": "Metadata Generation",
      "role": "metadata_semantic",
      "inputs": ["results", "structured_document"],
      "outputs": ["jsonld", "metadata", "citations"],
      "validation": ["schema_compliance", "doi_resolution"]
    }
  ],
  "boundaries": {
    "ai_may_not": ["generate hypotheses", "claim authorship", "alter theoretical content"],
    "ai_may": ["structure documents", "validate schemas", "generate metadata", "check reproducibility"]
  }
}
