  "about": [
    {
      "@type": "DefinedTerm",
      "name": "Regime-Consistent Measurement Principle",
      "description": "An observable must be interpreted through the variable most directly coupled to the physical driver in the phenomenon's operative regime"
    },
    {
      "@type": "DefinedTerm",
      "name": "Driver Proximity",
      "description": "Choose the most directly coupled observable within the operative regime"
    },
    {
      "@type": "DefinedTerm",
      "name": "Regime Tagging",
      "description": "Each measurement must be labeled with its dominant regime(s) using L0-L3 hierarchy"
    },
    {
      "@type": "DefinedTerm",
      "name": "Proxy Accounting",
      "description": "Each transformation carries an explicit uncertainty budget entry"
    },
    {
      "@type": "DefinedTerm",
      "name": "Coordinate Humility",
      "description": "The choice of coordinate system is not epistemically neutral"
    },
    {
      "@type": "DefinedTerm",
      "name": "Cross-Validation",
      "description": "Consistency must be tested across different proxy chains"
    }
  ],
