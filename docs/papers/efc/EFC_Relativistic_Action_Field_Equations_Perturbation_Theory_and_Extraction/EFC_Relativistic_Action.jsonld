  ],
  "about": [
    {
      "@type": "DefinedTerm",
      "name": "EFC Relativistic Action",
      "description": "Action coupling entropy-flow scalar field to gravity via F(phi)R with kinetic stiffness and flow constraint"
    },
    {
      "@type": "DefinedTerm",
      "name": "Entropy-Stiffness Mechanism",
      "description": "Physical reason mu < 1: flow constraint prevents scalar field from freely supporting gravitational collapse"
    },
    {
      "@type": "DefinedTerm",
      "name": "Flow-Anisotropy Mechanism",
      "description": "Physical reason Sigma > 1: Lagrange multiplier generates tensorial stress absent in standard scalar-tensor theories"
    }
  ],
