      "id": "Eq1",
      "latex": "\\frac{d\\Phi}{dt} = \\mu \\frac{d\\delta}{dt} + \\delta \\frac{d\\mu}{dt}",
      "terms": {
        "linear_ISW": "μ·(dδ/dt) — standard ISW (cold spot in voids)",
        "Rees_Sciama": "δ·(dμ/dt) — non-linear RS from density-dependent μ (hot spot in voids)"
      }
    },
    "mu_density": {
      "id": "Eq2-3",
      "latex": "\\mu(k, \\rho) = \\frac{1 + \\varepsilon_F}{F(1 + R(k, \\rho))}",
      "density_enters_through": "Γ'(ρ) in R(k,ρ)"
    },
    "chain_rule": {
      "id": "Eq4",
      "latex": "\\frac{d\\mu}{dt} = \\frac{d\\mu}{d\\rho} \\cdot \\frac{d\\rho}{dt}"
    },
    "amplitude_ratio": {
      "id": "Eq9",
      "latex": "A_{\\text{total}} \\equiv \\frac{\\Delta T_{\\text{EFC}}}{\\Delta T_{\\Lambda\\text{CDM}}} = \\frac{\\text{ISW}_{\\text{lin}} + \\text{RS}}{\\text{ISW}_{\\Lambda\\text{CDM}}}"
    },
    "scaling": {
      "id": "Eq10",
      "latex": "\\frac{|\\text{RS}|}{|\\text{ISW}_{\\text{lin}}|} \\propto |\\delta| \\cdot \\rho^{-1/2}"
    }
  },

