  "id": "efc-void-isw-signflip",
  "title": "Density-Dependent Gravitational Coupling Predicts ISW Sign-Flip in Deep Voids",
  "doi": "10.6084/m9.figshare.31942677",
  "version": "2.1",
  "date": "2026-04-06",
  "author": {
    "name": "Morten Magnusson",
