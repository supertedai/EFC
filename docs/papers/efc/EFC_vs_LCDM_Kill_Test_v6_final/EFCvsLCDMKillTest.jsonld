  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:KRhoBridge",
      "name": "K(ρ) Bridge",
      "description": "μ(k) = 1/(1+R(k)) with R(k) = K0·Θ(ρ)·(Γ'φ̇)²·a⁴/(M_Pl²·F·k⁴) and Θ(ρ) = exp(−(ρ/ρ*)²). Connects cosmological CMB lensing scale to galactic rotation curves via one parameter K0 ≈ 1.66."
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:GravitationalSlip",
      "name": "Gravitational Slip from δλ",
      "description": "f = 1 − V''(φ̄)/(K(ρ̄)·k²/a²) with V'' counter-term; sweet spot f ∈ [0.12, 0.18] yields η ∈ [1.20, 1.27] and Σ ∈ [1.03, 1.07]"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:TwoParameterAction",
      "name": "Two-Parameter Action",
      "description": "Single action with field parameters (K0, m²) produces μ, η, Σ from one mechanism — stiffness and slip are not independent"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:PredictiveChain",
      "name": "Predictive Chain",
      "description": "K0 → μ (stiffness via R ∝ k⁻⁴); m² → f → η → Σ (slip via V''/Kk²); Θ → 0 in dense regions gives GR in Solar System"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:SweetSpotWindow",
      "name": "Slip Sweet-Spot Window",
      "description": "f ∈ [0.12, 0.18] (25% wide), yielding η ∈ [1.20, 1.27] and Σ ∈ [1.03, 1.07] consistent with all cobaya runs"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:RegimeArchitecture",
      "name": "L0–L3 Regime Architecture",
      "description": "L0 (z>1100, α_S→0, GR+SM) | L1 (30<z<1100, linear growth) | L2 (0.5<z<30, α_L2≠0, late-time MG) | L3 (z~0, full entropy-flow, galactic)"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:NonRejectabilityStage",
      "name": "Non-Rejectability Stage",
      "description": "EFC cannot be rejected on current data; Δχ² ≤ 0 across all four cobaya minimize runs and all six probes. Full MCMC with Bayes evidence is the remaining definitive test."
    }
  ],
  "mainEntity": {
    "@type": "Claim",
    "name": "Six-Probe Non-Rejectability of EFC",
    "description": "Across DDO 154, SPARC multi-component refit, Bullet Cluster, CMB primary, A_L/(μ,Σ), and cobaya minimize (plik_lite + lowl + lensing + BAO + Pantheon+), EFC is either decisively preferred, tied, neutral by construction, or favoured with Δχ² ≤ 0. Direction is stable across datasets and parametrizations."
  },
