{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertedai.github.io/EFC/papers/efc/EFC-R-SPARC/schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "const": "EFC-Paper"
    },
    "collection": {
      "const": "efc"
    },
    "document_id": {
      "type": "string"
    },
    "chunks": {
      "type": "integer"
    }
  },
  "required": [
    "name",
    "type",
    "collection"
  ]
}