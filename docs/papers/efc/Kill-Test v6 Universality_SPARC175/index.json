  "abstract": "Kill-Test v6 (probe-2) established a decisive EFC advantage on five hand-refitted SPARC galaxies against a single-component NFW reference. This package extends the same methodology to all 175 SPARC galaxies, refuting the cherry-picking objection. On 171/175 galaxies (4 dropped for n<5 data points), single-component EFC wins 60.2% (42.1% EFC_decisive, 18.1% EFC), ties 26.9%, and loses 12.9% (9.4% LCDM_decisive, 3.5% LCDM). Median ΔAIC = +6.21 (favours EFC; AIC_NFW − AIC_EFC convention). Median χ²_red: EFC 0.44 vs NFW 1.69. Mann-Whitney test for FLOW (71 gal.) vs LATENT (16 gal.) gives p ≈ 0, ruling out the null hypothesis that the two regimes share a ΔAIC distribution. Spearman ρ(ΔAIC, v_max) = 0.11 (p = 0.15) rules out mass-scale selection bias. Kill-Test v6 probe-2 anchor DDO 154 reproduces at ΔAIC = +125.2 (sign convention verified). Universality verdict: CONFIRMED at the single-component level.",
  "headline_result": {
    "n_galaxies_total": 175,
    "n_fitted": 171,
    "n_failed": 4,
    "efc_win_rate_percent": 60.2,
    "lcdm_win_rate_percent": 12.9,
    "tie_rate_percent": 26.9,
    "efc_decisive_count": 72,
    "median_delta_aic": 6.213,
    "mean_delta_aic": 40.347,
    "median_chi2_red_efc": 0.4402,
    "median_chi2_red_nfw": 1.6866,
    "universality_verdict": "CONFIRMED",
    "cherry_picking_refuted": true
  },
  "verdict_distribution": {
    "EFC_decisive": 72,
    "EFC": 31,
    "tied": 46,
    "LCDM": 6,
    "LCDM_decisive": 16
  },
  "regime_distribution": {
    "FLOW": 71,
    "TRANSITION": 84,
    "LATENT": 16
  },
  "statistical_tests": {
    "mann_whitney_flow_vs_latent": {
      "alternative": "FLOW > LATENT (ΔAIC)",
      "U_statistic": 1136.0,
      "p_value": 0.0,
      "n_flow": 71,
      "n_latent": 16,
      "interpretation": "Rejects null hypothesis that FLOW and LATENT galaxies share a ΔAIC distribution"
    },
    "spearman_delta_aic_vs_vmax": {
      "rho": 0.1106,
      "p_value": 0.1497,
      "interpretation": "No significant correlation between EFC advantage and galaxy v_max — not a dwarf-galaxy artefact"
    }
  },
  "methodology": {
    "name": "Kill-Test v6 (single-component extension)",
    "optimiser": "scipy.optimize.differential_evolution",
    "seed": 42,
    "tolerance": 1e-8,
    "maxiter": 500,
    "init": "sobol",
    "polish": true,
    "efc_model": "v(r) = v_flat · sqrt(1 - exp(-(r/r_turnon)^sharpness))",
    "nfw_model": "v²(r) = V200² · [ln(1+s) - s/(1+s)] / [ln(1+c) - c/(1+c)] / (r/r200),  s = c·r/r200,  r200 = V200 / (10·H0·1e-3)",
    "H0": 67.4,
    "delta_aic_convention": "AIC_NFW - AIC_EFC (positive = EFC wins; matches Kill-Test v6 probe-2 where DDO 154 has ΔAIC = +35.4)",
    "efc_bounds": {
      "v_flat_km_s": [10.0, 350.0],
      "r_turnon_kpc": [0.05, 50.0],
      "sharpness": [0.3, 6.0]
    },
    "nfw_bounds": {
      "V200_km_s": [10.0, 400.0],
      "c": [1.0, 50.0]
    },
    "regime_thresholds": {
      "FLOW": "ΔAIC ≥ +10 AND χ²_red,EFC < 20",
      "LATENT": "ΔAIC ≤ -10 OR χ²_red,EFC > 50",
      "TRANSITION": "otherwise"
    },
    "verdict_thresholds": {
      "EFC_decisive": "ΔAIC > +10",
      "EFC": "+2 < ΔAIC ≤ +10",
      "tied": "-2 ≤ ΔAIC ≤ +2",
      "LCDM": "-10 ≤ ΔAIC < -2",
      "LCDM_decisive": "ΔAIC < -10"
    }
  },
  "data_source": {
    "file": "../Comprehensive-analysis-of-175-SPARC-galaxies-demonstrating-regime-dependent-validity-in-rotation-curve-modeling/sparc-n175-extended/sparc_rotation_curves.dat",
    "format": "Lelli+2016 Rotmod_LTG",
    "n_rows": 3391,
    "n_galaxies": 175,
    "columns": {
