{
  "id": "c-eff-parameterization",
  "title": "Toward a Quantitative c_eff(a): Parameterization, Constraints, and Degeneracy-Breaking Tests",
  "short_title": "c_eff Parameterization",
  "version": "3.0",
  "date": "2026-02-01",
  "author": {
    "name": "Morten Magnusson",
    "orcid": "0009-0002-4860-5095",
