{
  "id": "regime-dependent-growth-enhancement-fugaku-desi",
  "title": "Regime-Dependent Growth Enhancement: A Transition Metric Interpretation of the Fugaku-DESI Matter Density Offset",
  "short_title": "Fugaku-DESI Transition Metric",
  "version": "1.0",
  "date": "2026",
  "doi": "10.6084/m9.figshare.31140000",
  "author": {
    "name": "Morten Magnusson",
    "orcid": "0009-0002-4860-5095"
  },
  "type": "empirical_analysis",
  "status": "published",
  "abstract_short": "Reinterprets ~10% matter density offset in Fugaku N-body simulations as transition estimator Delta_F approx 0.1 measuring integrated regime transition strength rather than fundamental density parameter.",
  "keywords": [
    "DESI",
    "Fugaku",
    "N-body simulations",
    "transition metric",
    "matter density offset",
    "regime transition",
    "structure formation"
  ],
  "core_equations": [
    {
      "name": "Effective gravitational coupling",
      "formula": "mu(a) = G_eff(a)/G",
      "description": "Time-dependent effective gravitational coupling"
    },
    {
      "name": "Transition kernel",
      "formula": "mu(a) = 1 + Delta_mu * R((ln a - ln a_t)/sigma)",
      "description": "Smooth bounded transition function"
    },
    {
      "name": "Transition estimator",
      "formula": "Delta_F = integral W(a)[mu(a)-1] d ln a",
      "description": "Integrated transition strength"
    }
  ],
  "key_results": {
    "delta_F": 0.1,
    "interpretation": "10% matter density offset = integrated transition strength",
    "consistency_conditions": [
      {
        "regime": "CMB",
        "requirement": "mu approx 1 at recombination",
        "status": "satisfied"
      },
      {
        "regime": "DESI/Fugaku",
        "requirement": "Delta_F approx 0.1 in transition band",
        "status": "satisfied"
      },
      {
        "regime": "Galaxy",
        "requirement": "mu > 1 asymptotically",
        "status": "satisfied"
      }
    ]
  },
  "data_sources": [
    {
      "name": "DESI DR2 BAO",
      "reference": "arXiv:2404.03002"
    },
    {
      "name": "Planck 2018",
      "reference": "A&A 641, A6"
    },
