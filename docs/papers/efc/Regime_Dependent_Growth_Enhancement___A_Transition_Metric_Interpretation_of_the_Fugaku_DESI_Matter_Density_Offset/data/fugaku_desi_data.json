    {"regime": "Galaxy", "z": 0, "requirement": "mu > 1 asymptotically", "status": "satisfied"}
  ],
  "kernel_parameters": {
    "delta_mu": 0.1,
    "a_t": 0.55,
    "sigma": 0.3
  },
  "data_sources": {
    "desi_dr2_bao": {"reference": "arXiv:2404.03002", "type": "BAO"},
    "planck_2018": {"reference": "A&A 641, A6", "type": "CMB"},
    "fugaku_uchuu": {"reference": "MNRAS 506, 4210", "type": "N-body simulations"}
  }
}
