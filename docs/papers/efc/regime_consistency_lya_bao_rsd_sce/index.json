  "core_equations": {
    "transition_kernel": {
      "latex": "g_D(z) = \\frac{1 - \\Omega_m(z)}{1+z} \\ln(1+z)",
      "description": "Distance-coupling kernel"
    },
    "transition_function": {
      "latex": "T(z) = g_D(z) / g_D(z_{peak}), \\quad z_{peak} = 0.441",
      "description": "Normalised transition function, peaks at unity"
    },
    "modified_friedmann": {
      "latex": "H^2(a) = H_0^2 [\\Omega_m a^{-3} + \\Omega_\\Lambda (1 + \\beta \\cdot T(a))]",
      "description": "EFC background modification"
    }
  },
  "parameters": {
    "alpha_L2": {
      "value": 0.34,
      "uncertainty": 0.16,
      "description": "EFC coupling amplitude from BOSS DR12"
    },
    "beta": {
      "value": 0.08,
      "description": "Background coupling amplitude"
    },
    "z_peak": {
      "value": 0.441,
      "description": "Redshift where T(z) peaks"
    }
  },
