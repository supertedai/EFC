  "forbidden_patterns": [
    {
      "id": "EFC-FP-P1D",
      "definition": "If T(z=3)/T(peak) > 0.5 AND (|amplitude pull| > 3σ OR |slope pull| > 3σ), then regime-transition logic is inconsistent",
      "status": "Not triggered"
    },
    {
      "id": "EFC-FP-HIGHZ",
      "definition": "If Boltzmann solver with μ(z) = 1 + A·T(z) produces CMB Cl residuals exceeding Planck error bars",
      "status": "Not triggered"
    },
    {
      "id": "EFC-FP-RSD",
      "definition": "If fσ₈ deviates > 3σ at any BOSS z while αL2 within ±2σ of best-fit",
      "status": "Not triggered"
    },
    {
      "id": "EFC-FP-BAO",
      "definition": "If β > 0 simultaneously worsens both BAO and fσ₈ vs ΛCDM",
      "status": "Not triggered"
    },
    {
      "id": "EFC-FP-4CH",
      "definition": "If β passes BAO+RSD but fails CMB lensing or SN Ia > 3σ",
      "status": "Not triggered"
    }
