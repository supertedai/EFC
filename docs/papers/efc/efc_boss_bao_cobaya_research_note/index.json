    "orcid": "0009-0002-4860-5095",
    "affiliation": "Energy-Flow Cosmology Initiative"
  },
  "core_equations": {
    "efc_modified_friedmann": {
      "latex": "E^2_{EFC}(z) = E^2_{ΛCDM}(z) × [1 + α_{L2} · f(z) · Θ(z)]",
      "description": "EFC-modified Friedmann equation"
    },
    "coupling_function": {
      "latex": "f(z) = 1/(1+z)",
      "description": "Coupling function"
    },
    "regime_transition": {
      "latex": "Θ(z) = ½[1 + tanh((z_{L1L2} - z)/Δz)]",
      "description": "Regime transition function"
    }
  },
  "parameters": {
