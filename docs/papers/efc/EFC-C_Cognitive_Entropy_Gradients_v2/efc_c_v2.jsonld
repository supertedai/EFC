  "@type": "ScholarlyArticle",
  "name": "EFC-C v2.1: Degree-Heterogeneity Entropy-Gradient Predictions for Cognitive States",
  "description": "Revision of EFC-C replacing the Fiedler-eigenvalue formulation (Bridge B1*) with the empirically-supported degree-heterogeneity formulation (Bridge B1**). Centrifugal entropy score κ is predicted from hub-to-periphery degree ratio D_ratio via power-law κ = C_eff · D_ratio^γ. Predictions separated into Layer A (topological, invariant under C_eff) and Layer B (absolute-scale, conditional on Bridge validity).",
  "datePublished": "2026-04-06",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "author": {
    "@type": "Person",
    "@id": "https://orcid.org/0009-0002-4860-5095",
    "name": "Morten Magnusson",
    "affiliation": {
      "@type": "Organization",
      "name": "Symbiose Research, Sandnes, Norway"
    }
  },
  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:CentrifugalEntropyScore",
      "name": "Centrifugal Entropy Score κ",
      "description": "κ = ⟨S_hub⟩/⟨S_periph⟩; healthy ≈2.2, range [1.7,2.6]"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:DegreeHeterogeneity",
      "name": "Hub-to-Periphery Degree Ratio D_ratio",
      "description": "D_ratio = ⟨k_hub⟩/⟨k_periph⟩; baseline ≈1.2"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:BridgeB1DoubleStar",
      "name": "Bridge B1** Equation",
      "description": "κ = C_eff · D_ratio^γ (degree-heterogeneity formulation, cross-domain from galactic dynamics)"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:RegimeTransform",
      "name": "Effective Cross-Domain Constant C_eff",
      "description": "C_eff = κ_reg · k/a_G = 2.0±0.15, fixed prior to neural analysis via RCMP regime transformation"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:PowerLawExponent",
      "name": "Power-Law Exponent γ",
      "description": "γ ≈ 0.55±0.05, one empirical fit parameter constrained to [0.5,0.6]"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:LayerATopological",
      "name": "Layer A: Topological Predictions",
      "description": "A1 (structural-entropic coupling: Δlog κ = γ·Δlog D_ratio), A2 (anterior-posterior asymmetry in schizophrenia), A3 (posterior asymmetry in MDD); invariant under C_eff"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:LayerBAbsolute",
      "name": "Layer B: Absolute-Scale Predictions",
      "description": "B1 (κ_healthy ∈ [1.7,2.6]), B2 (κ_crit ≲ 1.9 at D_ratio ≲ 0.9); conditional on Bridge validity"
    }
  ],
