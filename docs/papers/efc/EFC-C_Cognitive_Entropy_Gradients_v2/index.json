  "type": "quantitative_prediction",
  "status": "research_note",

  "abstract": "Revised EFC-C framework introducing three falsifiable predictions grounded in the centrifugal entropy score kappa = <S_hub>/<S_periph>. Using Bridge B1*, kappa_healthy = C/(1 + lambda_2 * tau_c) where C = 4.4 from galactic dynamics. Extends to psychiatric populations via disorder-specific changes in structural connectome algebraic connectivity.",

  "keywords": [
    "neural entropy", "connectome topology", "Fiedler eigenvalue",
    "psychiatric biomarkers", "entropy gradient", "resting-state fMRI",
    "schizophrenia", "depression", "centrifugal entropy score", "EFC-C"
  ],

  "key_equations": {
    "kappa_definition": "kappa = <S_hub> / <S_periph>",
    "kappa_healthy": "kappa_healthy = C / (1 + lambda_2(W) * tau_c)",
    "delta_kappa": "Delta_kappa = C * [1/(1 + lambda_2_h * tau_c) - 1/(1 + lambda_2_d * tau_c)]",
    "alpha_AP": "alpha_AP = <S_anterior_hub> / <S_posterior_hub>",
    "kappa_crit": "kappa_crit = C / (1 + lambda_2_max * tau_c_max) = 0.73"
  },

  "parameters": {
    "C": {"value": 4.4, "uncertainty": 0.6, "source": "SPARC galactic fit (Spor 1)"},
    "lambda_2_typical": {"value": 0.5, "range": [0.3, 0.8], "source": "HCP structural connectome"},
    "tau_c": {"value": 3.5, "unit": "s", "range": [2.0, 5.0], "derivation": "L_parcel^2/D_eff"},
    "kappa_healthy_central": {"value": 1.6},
    "kappa_crit": {"value": 0.73}
  },

  "predictions": [
    {"id": "Q1", "description": "kappa_healthy ~ 1.6; kappa scales as 1/lambda_2", "falsification": "r < 0.30 or |z| > 3"},
    {"id": "Q2a", "description": "alpha_AP_scz > alpha_AP_healthy (anterior-dominant elevation)", "falsification": "p > 0.05"},
    {"id": "Q2b", "description": "alpha_AP_mdd < alpha_AP_healthy (posterior-shifted)", "falsification": "p > 0.05"},
    {"id": "Q2c", "description": "Delta_kappa correlates with Delta_lambda_2", "falsification": "r < 0.25"},
    {"id": "Q3", "description": "kappa < 0.73 in disorders of consciousness", "falsification": "kappa_DoC > 0.73"}
  ],

  "datasets": [
    {"name": "HCP 1200", "n": 50, "population": "healthy", "modalities": ["DTI", "rs-fMRI"]},
    {"name": "OpenNeuro ds000030", "n": 100, "population": "schizophrenia + healthy", "modalities": ["structural", "rs-fMRI"]},
    {"name": "OpenNeuro ds000171", "n": 40, "population": "MDD + healthy", "modalities": ["rs-fMRI"]}
  ],

