  "id": "efc-c-cognitive-entropy-gradients-v2",
  "title": "EFC-C v2.0: Quantitative Entropy-Gradient Predictions for Cognitive States",
  "short_title": "EFC-C v2 Cognitive Entropy Gradients",
  "version": "2.0",
  "date": "2026-04-06",
  "author": {
    "name": "Morten Magnusson",
    "orcid": "0009-0002-4860-5095",
