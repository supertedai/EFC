{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertedai.github.io/EFC/papers/efc/EFC-C_Cognitive_Entropy_Gradients_v2/schema.json",
  "title": "EFC-C v2.1 Cognitive Entropy Gradients Schema",
  "description": "Validation schema for centrifugal entropy score and degree-heterogeneity bridge predictions",
  "type": "object",
  "properties": {
    "kappa": {
      "type": "object",
      "properties": {
        "S_hub_mean": {"type": "number", "description": "Mean entropy of hub regions", "minimum": 0},
        "S_periph_mean": {"type": "number", "description": "Mean entropy of peripheral regions", "minimum": 0},
        "kappa_value": {"type": "number", "description": "Centrifugal entropy score S_hub/S_periph", "minimum": 0}
      },
      "required": ["kappa_value"]
    },
    "connectome": {
      "type": "object",
      "properties": {
        "D_ratio": {"type": "number", "description": "Hub-to-periphery degree ratio ⟨k_hub⟩/⟨k_periph⟩", "minimum": 0},
        "n_regions": {"type": "integer", "description": "Number of parcellation regions", "minimum": 1},
        "hub_threshold_percentile": {"type": "number", "minimum": 0, "maximum": 100},
        "periph_threshold_percentile": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "required": ["D_ratio"]
    },
    "bridge_parameters": {
      "type": "object",
      "properties": {
        "C_eff": {"type": "number", "description": "Regime-transformed cross-domain constant", "minimum": 0},
        "gamma": {"type": "number", "description": "Power-law exponent (empirical fit parameter)", "minimum": 0.5, "maximum": 0.6},
        "tau_c": {"type": "number", "description": "Cortical entropy redistribution timescale [s]", "minimum": 0}
      },
      "required": ["C_eff", "gamma"]
    },
    "prediction": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "enum": ["A1", "A2", "A3", "B1", "B2"]},
        "layer": {"type": "string", "enum": ["A", "B"]},
        "kappa_predicted": {"type": "number"},
        "falsified": {"type": "boolean"}
      },
      "required": ["id", "layer"]
    },
    "alpha_AP": {
      "type": "object",
      "properties": {
        "S_anterior_hub": {"type": "number", "minimum": 0},
        "S_posterior_hub": {"type": "number", "minimum": 0},
        "alpha_AP_value": {"type": "number", "minimum": 0}
      }
    }
  },
  "required": ["kappa"]
}
