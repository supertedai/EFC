      "value": 3.2408e-20,
      "unit": "1/s per km/s/Mpc",
      "description": "Unit conversion factor"
    }
  },

  "conjecture_1": {
    "name": "Transition acceleration",
    "formula": "g_dagger = c * H0 / e",
    "motivation": "One e-fold drop in grid stiffness at S = delta_S",
    "predictions": {
      "H0_67_4": {
        "H0": 67.4,
