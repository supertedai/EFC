  },

  "conjecture_2": {
    "name": "Phase factor",
    "formula": "C = 2e - 1",
    "numerical_value": 4.436563656918091,
    "interpretation": "Galactic phase = (e-1) + e"
  },

  "key_prediction": {
    "formula": "H0 = e * g_dagger / c",
    "sparc_input": {
      "g_dagger": 2.51e-10,
      "g_dagger_error": 0.60e-10,
      "unit": "m/s^2"
    },
    "result": {
      "H0": 70.2,
