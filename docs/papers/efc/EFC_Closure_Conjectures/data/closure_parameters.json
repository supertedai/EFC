      "sh0es_H0": 73.0,
      "sh0es_status": "within 1 sigma",
      "trgb_H0": 69.8,
      "trgb_status": "within 1 sigma"
    }
  },

  "irreducible_parameter": {
    "name": "a_G",
    "value": 0.094,
    "derived_k": 0.417,
    "k_formula": "k = a_G * C = a_G * (2e - 1)",
    "note": "Cannot currently be derived from simpler quantities"
  },

  "falsification_conditions": [
    {
      "id": "F1",
      "condition": "g_dagger measurements with <10% uncertainty inconsistent with c*H0/e at >3 sigma"
