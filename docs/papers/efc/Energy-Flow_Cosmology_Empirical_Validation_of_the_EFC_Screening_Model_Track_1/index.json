    },
    "cmb_lensing": {
      "S8": 0.828,
      "error": 0.012
    },
    "efc_prediction": {
      "sigma8": 0.805,
      "beta": 0.08
    }
  },
  "falsification_criteria": [
    {
      "id": "F1",
      "condition": "k outside [0.30, 0.55] from independent SPARC re-analysis"
    },
    {
      "id": "F2",
