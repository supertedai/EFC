    "@id": "https://energyflow-cosmology.com/",
    "name": "Energy-Flow Cosmology (EFC)"
  },
  "about": [
    {
      "@type": "DefinedTerm",
      "@id": "efc:GridAction",
      "name": "Grid Action S_grid",
      "description": "Three-term minimal Lagrangian: kinetic ½m_eff(∂_t ξ)², bare elastic ½κ₀(∇ξ)², gradient coupling ½α|∇Φ|(∇ξ)²"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:EffectiveStiffness",
      "name": "Effective Stiffness",
      "description": "κ_eff(x) = κ₀ + αg(x), emergent from Euler-Lagrange variation of S_grid"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:GradientCouplingTheorem",
      "name": "Gradient Coupling Theorem (Theorem 1)",
      "description": "In the gravitational regime (αg ≫ κ₀), the grid excitation energy satisfies E ∝ √g"
    },
    {
      "@type": "DefinedTerm",
      "@id": "efc:OperatorUniqueness",
      "name": "Operator Uniqueness",
      "description": "Systematic elimination of C1(ρ), C2(Φ), C3(g²), C4(∇²Φ); only C5(|∇Φ|) survives"
    }
  ],
