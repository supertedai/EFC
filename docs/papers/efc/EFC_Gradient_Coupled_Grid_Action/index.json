  "abstract": "Derives the EFC screening relation E ∝ √g from a minimal three-term Lagrangian S_grid. The gradient coupling ½α|∇Φ|(∇ξ)² produces an effective stiffness κ_eff = κ₀ + αg, yielding a local dispersion relation whose gravitational-regime limit recovers E ∝ √g as a theorem. Operator uniqueness is established by systematically eliminating four alternative couplings.",

  "keywords": [
    "grid action",
    "gradient coupling",
    "effective stiffness",
    "dispersion relation",
    "operator uniqueness",
    "bosonic quantisation",
    "Bose-Einstein",
    "screening relation",
    "EFC",
    "dark matter alternative",
    "Lagrangian mechanics",
    "WKB approximation"
  ],

  "key_equations": {
    "grid_action": "S_grid = ∫ dt d³x [½m_eff(∂_t ξ)² − ½κ₀(∇ξ)² − ½α|∇Φ|(∇ξ)²]",
    "effective_stiffness": "κ_eff(x) = κ₀ + α g(x)",
    "dispersion": "ω²(k,g) = (κ₀ + αg)/m_eff · k²",
    "theorem_1": "E = ℏω ∝ √g  (when αg ≫ κ₀)",
    "crossover": "g_cross = κ₀/α",
    "hamiltonian": "H = Σ_k ℏω_k (a†_k a_k + ½)",
    "thermal_occupation": "⟨n_k⟩ = 1/(exp(ℏω_k/k_BT) − 1)"
  },

  "key_results": [
    {
      "id": "theorem-1",
      "description": "E ∝ √g derived from minimal Lagrangian in gravitational regime",
      "equation": "E = ℏ√(αg/m_eff) · k"
    },
    {
      "id": "operator-uniqueness",
      "description": "Only C5 = |∇Φ| coupling survives dimensional, symmetry, and locality constraints",
      "eliminated": ["C1: ρ(x)", "C2: Φ(x)", "C3: g²", "C4: ∇²Φ"]
    },
    {
      "id": "three-regimes",
      "description": "Bare elastic (κ₀ ≫ αg), gravitational (αg ≫ κ₀), transition (αg ~ κ₀)",
      "crossover": "g_cross = κ₀/α"
    },
    {
      "id": "derivation-chain",
      "description": "Complete chain: S_grid → E-L → WKB → E ∝ √g → BE → μ(g)"
    }
  ],

  "predictions": [
