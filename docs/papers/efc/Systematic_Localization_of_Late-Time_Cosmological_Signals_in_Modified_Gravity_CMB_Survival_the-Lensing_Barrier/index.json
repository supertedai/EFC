  "type": "localization_analysis",
  "status": "published",
  "abstract_short": "Five-phase localization study testing EFC against Planck 2018 CMB, DESI 2024 BAO, SDSS DR12 BAO, and Pantheon+ SNe. Background sector is observationally empty (α → 0 under joint constraints). Perturbation sector survives Planck within a narrow slip window (μ ∈ [0.93, 0.96], Σ ∈ [1.03, 1.07]). The (μ, Σ) valley is degenerate with the A_L anomaly (cos = 0.93), but fσ₈ data independently confirm μ < 1 at > 2σ, breaking the degeneracy.",
  "keywords": [
    "EFC",
    "modified gravity",
    "CMB constraints",
    "gravitational slip",
    "fσ₈",
    "A_L anomaly",
    "dark energy perturbations",
    "Planck 2018",
    "DESI BAO",
    "MGCAMB",
    "μ–Σ parametrization",
    "lensing barrier",
    "S₈ tension",
    "growth rate",
    "Hubble friction"
  ],
  "efc_channel": {
    "name": "Perturbation Sector (μ–Σ)",
    "regime": "EFC-D, Cosmological perturbations",
    "pipeline": "EFCLASS + MGCAMB + cobaya"
  },
  "core_equations": {
    "efc_friedmann": {
      "latex": "E^2(a) = E^2_{\\Lambda CDM}(a) + \\alpha\\, g(a)",
      "description": "EFC background modification with logistic gate g(a)"
    },
    "logistic_gate": {
      "latex": "g(a) = [1 + \\exp(-(a - a_t)/\\delta_a)]^{-1}",
      "description": "Logistic gate activating at scale factor a_t with width δ_a"
    },
    "mu_parametrization": {
      "latex": "-k^2 \\Psi = 4\\pi G a^2 \\mu(a,k) \\rho \\Delta",
      "description": "Modified Poisson equation with μ (matter-potential coupling)"
    },
    "sigma_parametrization": {
      "latex": "-k^2 (\\Phi + \\Psi) = 8\\pi G a^2 \\Sigma(a,k) \\rho \\Delta",
      "description": "Lensing potential modification with Σ"
    },
    "gravitational_slip": {
      "latex": "\\eta = \\Phi / \\Psi \\neq 1",
      "description": "Gravitational slip parameter; η ≠ 1 requires two independent metric potentials"
    }
  },
  "parameters": {
    "alpha_background": {
      "value": -0.045,
      "uncertainty": null,
      "description": "Best-fit background coupling (joint Planck+DESI+Pantheon+). Consistent with zero.",
      "status": "observationally_empty"
    },
    "mu_sweet_spot": {
      "value": 0.94,
      "range": [
        0.93,
        0.96
      ],
      "description": "Poisson equation modification (μ < 1 = weakened gravity)"
    },
    "sigma_sweet_spot": {
      "value": 1.05,
      "range": [
        1.03,
        1.07
      ],
      "description": "Lensing potential modification (Σ > 1 = enhanced lensing)"
    },
    "eta_slip": {
      "value": 1.12,
      "description": "Gravitational slip η = Σ/μ ≈ 1.05/0.94 at sweet spot"
    },
    "sigma_lensing_fit": {
      "value": 1.047,
      "uncertainty": 0.013,
      "description": "Parabolic fit to lensing likelihood at μ = 0.94"
    },
    "corr_alpha_H0": {
      "value": 0.975,
      "description": "Near-perfect degeneracy between α and H₀ in Planck-only fit"
    }
  },
  "data": {
    "CMB": {
