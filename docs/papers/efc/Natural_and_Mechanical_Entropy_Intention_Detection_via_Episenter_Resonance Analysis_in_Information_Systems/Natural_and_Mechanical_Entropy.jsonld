      "name": "Natural Entropy",
      "description": "Uncertainty arising from intrinsic system dynamics with distributed episenter"
    },
    {
      "@type": "DefinedTerm",
      "name": "Mechanical Entropy",
      "description": "Uncertainty shaped by external structural intervention with localised episenter"
