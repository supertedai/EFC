{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "natural-mechanical-entropy-intention-detection-schema",
  "title": "Natural and Mechanical Entropy Paper Schema",
  "description": "JSON Schema for the AI-friendly metadata of the Natural and Mechanical Entropy paper",
  "type": "object",
  "required": ["paper_id", "title", "authors", "version", "date", "status", "abstract", "core_concepts", "detection_framework", "falsifiable_predictions"],
  "properties": {
    "paper_id": {"type": "string"},
    "title": {"type": "string"},
    "short_title": {"type": "string"},
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "affiliation": {"type": "string"},
          "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"}
        }
      }
    },
    "version": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["working_paper", "preprint", "published"]},
    "framework": {"type": "string"},
    "subframework": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "abstract": {"type": "string"},
    "epistemic_status": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "peer_reviewed": {"type": "boolean"},
        "empirical_protocol_executed": {"type": "boolean"},
        "empirical_protocol_proposed": {"type": "boolean"},
        "falsifiable_predictions": {"type": "integer"},
        "case_studies": {"type": "integer"}
      }
    },
    "core_concepts": {
      "type": "object",
      "properties": {
        "structural_intention": {
          "type": "object",
          "required": ["symbol", "definition", "formula"],
          "properties": {
            "symbol": {"type": "string"},
            "definition": {"type": "string"},
            "formula": {"type": "string"},
            "properties": {"type": "array", "items": {"type": "string"}},
            "zero_condition": {"type": "string"}
          }
        },
        "natural_entropy": {
          "type": "object",
          "required": ["symbol", "definition", "formula"],
          "properties": {
            "symbol": {"type": "string"},
            "definition": {"type": "string"},
            "formula": {"type": "string"},
            "properties": {"type": "array", "items": {"type": "string"}}
          }
        },
        "mechanical_entropy": {
          "type": "object",
          "required": ["symbol", "definition", "formula"],
          "properties": {
            "symbol": {"type": "string"},
            "definition": {"type": "string"},
            "formula": {"type": "string"},
            "coupling_constant": {"type": "string"},
            "recovery": {"type": "string"},
            "key_difference": {"type": "string"}
          }
        },
        "entropy_class_residual": {
          "type": "object",
          "required": ["symbol", "formula"],
          "properties": {
            "symbol": {"type": "string"},
            "formula": {"type": "string"},
            "interpretation": {"type": "object"}
          }
        }
      }
    },
    "detection_framework": {
      "type": "object",
      "required": ["diagnostics", "combined_criterion"],
      "properties": {
        "name": {"type": "string"},
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "symbol", "formula"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "symbol": {"type": "string"},
              "formula": {"type": "string"}
            }
          }
        },
        "combined_criterion": {"type": "string"}
      }
    },
    "case_studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "domain"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "domain": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "falsifiable_predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domain", "prediction"],
        "properties": {
          "id": {"type": "string"},
          "domain": {"type": "string"},
          "prediction": {"type": "string"}
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
