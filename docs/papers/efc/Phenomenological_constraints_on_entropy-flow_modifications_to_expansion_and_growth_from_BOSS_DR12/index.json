      "src/__init__.py"
    ],
    "data": [
      "data/boss_dr12_consensus.json",
      "data/fit_results.json"
    ],
    "examples": [
      "examples/phenomenology_fit.py"
    ]
  },
  "figshare_url": "https://doi.org/10.6084/m9.figshare.31243828"
